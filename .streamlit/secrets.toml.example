# Esempio dei Secrets. I valori veri vanno SOLO su Streamlit Cloud (Manage app > Settings > Secrets), mai su GitHub.
# Le stringhe vanno sempre tra virgolette.

GEMINI_API_KEY = "la-tua-chiave-gemini"

# Database PostgreSQL esterno (es. Neon, regione UE)
DATABASE_URL = "postgresql://utente:password@host/neondb?sslmode=require"

# Utenti (consigliato: almeno un amministratore). Hash con: python make_hash.py
[users.admin]
hash = "pbkdf2_sha256$..."
ruolo = "admin"

# Solo compatibilita' (sconsigliato): password condivisa, accesso come utente "admin"
# APP_PASSWORD = "scegli-una-password-lunga"
