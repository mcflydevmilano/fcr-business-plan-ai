# Copia questi valori in Streamlit Cloud: Manage app > Settings > Secrets (NON caricare il file con i valori veri su GitHub).
# Le stringhe vanno sempre tra virgolette.

GEMINI_API_KEY = "la-tua-chiave-gemini"

# Database PostgreSQL esterno (es. Neon, regione UE): rende persistenti utenti, pratiche, scadenzari, registro attivita'
DATABASE_URL = "postgresql://utente:password@host/neondb?sslmode=require"

# Utenti (consigliato: almeno un amministratore). Hash con:  python make_hash.py
[users.admin]
hash = "pbkdf2_sha256$..."
ruolo = "admin"

# Solo compatibilita' (sconsigliato): password condivisa, accesso come utente "admin"
# APP_PASSWORD = "scegli-una-password-lunga"

# Studio legale: dove inviare i fascicoli dei clienti (serve anche la posta SMTP, oppure uno Slack dedicato)
# SMTP_HOST = "smtp.esempio.it"
# SMTP_USER = "app@esempio.it"
# SMTP_PASSWORD = "password-della-casella"
# STUDIO_LEGALE_EMAIL = "studio@esempio.it"
# STUDIO_LEGALE_SLACK_WEBHOOK_URL = "https://hooks.slack.com/services/..."
